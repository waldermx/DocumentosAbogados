# Copia este archivo a `.env` y rellena los valores.
# `.env` está en .gitignore: nunca se versiona.
#
#   docker run --env-file .env -p 8080:8080 docapi
#
# Todas las claves siguen el patrón de ASP.NET Core: la sección y la clave
# separadas por doble guion bajo (`Auth:MasterPassword` -> `Auth__MasterPassword`).

## Obligatorias ---------------------------------------------------------------

# Password que el cliente envía como `Authorization: Bearer`.
Auth__MasterPassword=

# Id de la hoja de cálculo (el tramo entre /d/ y /edit en la URL de Google Sheets).
GoogleSheets__SpreadsheetId=

## Credenciales de Google — elige UNA de las dos ------------------------------

# A) El JSON de la service account en una sola línea (lo cómodo en Docker).
#    Genéralo con:  jq -c . service-account.json
#GoogleSheets__ServiceAccountJson={"type":"service_account","project_id":"..."}

# B) Ruta al archivo JSON dentro del contenedor (móntalo como volumen o secreto).
#GoogleSheets__ServiceAccountJsonPath=/run/secrets/service-account.json

# Recuerda compartir la hoja con el email de la service account, con permiso de lectura.

## Opcionales — descomenta solo para cambiar el valor por defecto --------------

# Rango A1 de la columna principal (la que pasa por los regex). Por defecto: Hoja1!C:C
# Si el nombre de la hoja lleva espacios o guiones, entrecomíllalo:  'S-da'!C:C
#GoogleSheets__Range=Hoja1!C:C

# Si la primera fila del rango es encabezado. Por defecto: true
#GoogleSheets__TieneEncabezado=true

# Columnas extra: se copian tal cual y se unen por número de fila.
# OJO: es una LISTA, así que lleva el ÍNDICE (__0__) entre la clave y el campo.
# Sin el índice la variable se ignora en silencio.
# `Nombre` es el marcador que usarás en la plantilla: {{nombre}}.
# Todos los rangos deben estar en la misma hoja y arrancar en la misma fila que Range.
#GoogleSheets__ColumnasExtra__0__Nombre=nombre
#GoogleSheets__ColumnasExtra__0__Range='S-da'!J:J

# Una segunda columna extra sería el índice 1, y así:
#GoogleSheets__ColumnasExtra__1__Nombre=juez
#GoogleSheets__ColumnasExtra__1__Range='S-da'!K:K

# Patrones .NET con grupos con nombre; cada grupo se vuelve un marcador {{nombre}}.
# Es una LISTA y se prueban en orden: gana el primero que coincida.
# Ojo con el escapado: en un archivo .env el valor se toma literal, sin comillas.
# Si defines solo el índice 0, pierdes el patrón de respaldo (el de las filas sin circuito).
#Parsing__Regexes__0=^(?<consecutivo>\d+/\d{4})\s+(?<colegio>.+?)\s+DEL\s+(?<circuito>.+)$
#Parsing__Regexes__1=^(?<consecutivo>\d+/\d{4})\s+(?<colegio>.+)$

# Cada cuánto se consulta si la hoja cambió, en minutos. Por defecto: 5
#Sync__PollingIntervalMinutes=5

# Dónde persistir el caché. Vacío = solo memoria.
# Monta un volumen en /app/cache para conservarlo entre despliegues.
#Sync__CacheFilePath=cache/sheet-cache.json
