{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "DocApi.Services.SyncCoordinator": "Information"
    }
  },
  "AllowedHosts": "*",

  "GoogleSheets": {
    "ServiceAccountJsonPath": "",
    "ServiceAccountJson": "",
    "SpreadsheetId": "",
    "Range": "Hoja1!C:C",
    "SourceColumnName": "Asunto",
    "TieneEncabezado": true
  },

  "Parsing": {
    "Regex": "^(?<consecutivo>\\d+/\\d{4})\\s+(?<colegio>.+?)\\s+DEL\\s+(?<circuito>.+)$"
  },

  "Auth": {
    "MasterPassword": ""
  },

  "Sync": {
    "PollingIntervalMinutes": 5,
    "CacheFilePath": "cache/sheet-cache.json"
  }
}
