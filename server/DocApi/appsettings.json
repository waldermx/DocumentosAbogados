{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "DocApi.Services.SyncCoordinator": "Information"
    }
  },
  "AllowedHosts": "*",

  "GoogleSheets": {
    "ServiceAccountJsonPath": "",
    "ServiceAccountJson": "",
    "SpreadsheetId": "",
    "Range": "Hoja1!C:C",
    "SourceColumnName": "Asunto",
    "TieneEncabezado": true,
    "ColumnasExtra": [
      { "Nombre": "nombre", "Range": "Hoja1!D:D" }
    ]
  },

  "Parsing": {
    "Regexes": [
      "^(?<consecutivo>\\d+/\\d{4})\\s+(?<colegio>.+?)\\s+DEL\\s+(?<circuito>.+)$",
      "^(?<consecutivo>\\d+/\\d{4})\\s+(?<colegio>.+)$"
    ]
  },

  "Auth": {
    "MasterPassword": ""
  },

  "Sync": {
    "PollingIntervalMinutes": 5,
    "CacheFilePath": "cache/sheet-cache.json"
  }
}
