<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DocGenApp.ViewModels"
        xmlns:models="clr-namespace:DocGenApp.Models"
        xmlns:views="clr-namespace:DocGenApp.Views"
        x:Class="DocGenApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Title="Generador de documentos"
        Width="1140" Height="760"
        MinWidth="880" MinHeight="600"
        Background="{DynamicResource SuperficieFondo}">

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Barra superior -->
    <Border Grid.Row="0"
            Background="{DynamicResource SuperficiePanel}"
            BorderBrush="{DynamicResource Borde}"
            BorderThickness="0,0,0,1"
            Padding="20,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Classes="titulo" Text="Generador de documentos" />
          <TextBlock Classes="subtitulo" Text="{Binding MensajeEstado}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Classes="subtitulo"
                     VerticalAlignment="Center"
                     Text="{Binding UltimaSyncTexto}"
                     IsVisible="{Binding UltimaSyncTexto, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Button Content="Actualizar"
                  Command="{Binding RefrescarCommand}"
                  IsEnabled="{Binding !EstaOcupado}" />
          <Button Content="Cambiar password"
                  Command="{Binding OlvidarPasswordCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Avisos -->
    <StackPanel Grid.Row="1" Margin="20,14,20,0" Spacing="10">

      <!-- Password maestra -->
      <Border Classes="panel banner"
              Background="{DynamicResource SuperficiePanel}"
              BorderBrush="{DynamicResource Acento}"
              IsVisible="{Binding PidePassword}">
        <StackPanel Spacing="10">
          <TextBlock Classes="etiqueta" Text="PASSWORD MAESTRA" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0"
                     Margin="0,0,10,0"
                     PasswordChar="•"
                     Watermark="Password del servidor"
                     Text="{Binding PasswordIngresada, Mode=TwoWay}" />
            <Button Grid.Column="1"
                    Content="Conectar"
                    IsDefault="True"
                    Command="{Binding ConfirmarPasswordCommand}" />
          </Grid>
          <TextBlock Classes="subtitulo"
                     Text="Se guarda cifrada con DPAPI en tu perfil de Windows; nunca en texto plano." />
        </StackPanel>
      </Border>

      <!-- Datos del abogado: locales al equipo, iguales para todos los documentos -->
      <Expander IsExpanded="{Binding AbogadoExpandido, Mode=TwoWay}"
                HorizontalAlignment="Stretch">
        <Expander.Header>
          <StackPanel Spacing="1">
            <TextBlock Classes="etiqueta" Text="DATOS DEL ABOGADO" />
            <TextBlock Classes="subtitulo" Text="{Binding ResumenAbogado}" />
          </StackPanel>
        </Expander.Header>

        <StackPanel Spacing="12" Margin="0,6,0,0">
          <Grid ColumnDefinitions="*,12,*,12,*">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Classes="etiqueta" Text="NOMBRE" />
              <TextBox Watermark="Nombre completo"
                       Text="{Binding AbogadoNombre, Mode=TwoWay}" />
              <TextBlock Classes="subtitulo"
                         FontFamily="Consolas,Menlo,monospace"
                         Text="{}{{abogadoNombre}}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Classes="etiqueta" Text="USUARIO FIREL" />
              <TextBox Watermark="Usuario FIREL"
                       Text="{Binding AbogadoFirel, Mode=TwoWay}" />
              <TextBlock Classes="subtitulo"
                         FontFamily="Consolas,Menlo,monospace"
                         Text="{}{{abogadoFirel}}" />
            </StackPanel>

            <StackPanel Grid.Column="4" Spacing="4">
              <TextBlock Classes="etiqueta" Text="CÉDULA PROFESIONAL" />
              <TextBox Watermark="Número de cédula"
                       Text="{Binding AbogadoCedula, Mode=TwoWay}" />
              <TextBlock Classes="subtitulo"
                         FontFamily="Consolas,Menlo,monospace"
                         Text="{}{{abogadoCedula}}" />
            </StackPanel>
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Content="Guardar datos" Command="{Binding GuardarAbogadoCommand}" />
            <TextBlock Classes="subtitulo"
                       VerticalAlignment="Center"
                       Text="{Binding MensajeAbogado}"
                       IsVisible="{Binding MensajeAbogado, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <TextBlock Classes="subtitulo"
                     TextWrapping="Wrap"
                     Text="Se guardan solo en este equipo y se aplican a todos los documentos que generes." />
        </StackPanel>
      </Expander>

      <!-- Sin conexión: solo lectura -->
      <Border Classes="banner"
              Background="{DynamicResource AvisoFondo}"
              IsVisible="{Binding EsSoloLectura}">
        <TextBlock Foreground="{DynamicResource Aviso}"
                   TextWrapping="Wrap"
                   Text="{Binding MensajeEstado}" />
      </Border>

      <!-- Éxito al generar -->
      <Border Classes="banner"
              Background="{DynamicResource ExitoFondo}"
              IsVisible="{Binding MensajeExito, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Foreground="{DynamicResource Exito}"
                   TextWrapping="Wrap"
                   Text="{Binding MensajeExito}" />
      </Border>

    </StackPanel>

    <!-- Contenido -->
    <Grid Grid.Row="2" Margin="20,14,20,20" ColumnDefinitions="380,14,*">

      <!-- Lista de registros -->
      <Border Grid.Column="0" Classes="panel">
        <Grid RowDefinitions="Auto,Auto,*,Auto">

          <StackPanel Grid.Row="0" Spacing="8" Margin="14,12,14,8">
            <TextBlock Classes="etiqueta" Text="REGISTROS" />
            <TextBox Watermark="Filtrar por texto, nombre o fila…"
                     Text="{Binding Filtro, Mode=TwoWay}" />
          </StackPanel>

          <!-- Selección masiva -->
          <Border Grid.Row="1"
                  Background="{DynamicResource SuperficieFondo}"
                  BorderBrush="{DynamicResource Borde}"
                  BorderThickness="0,1,0,1"
                  Padding="14,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <CheckBox Grid.Column="0"
                        IsThreeState="True"
                        IsChecked="{Binding TodosMarcados, Mode=TwoWay}"
                        ToolTip.Tip="Marca o desmarca todos los registros visibles con el filtro actual">
                <TextBlock Classes="subtitulo" Text="Seleccionar todos" VerticalAlignment="Center" />
              </CheckBox>

              <TextBlock Grid.Column="1"
                         Classes="subtitulo"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Margin="8,0">
                <Run Text="{Binding TotalMarcados}" />
                <Run Text="marcado(s)" />
              </TextBlock>

              <Button Grid.Column="2"
                      Content="Limpiar"
                      Padding="10,4"
                      FontSize="12"
                      Command="{Binding DesmarcarTodosCommand}"
                      IsEnabled="{Binding HayMarcados}" />
            </Grid>
          </Border>

          <ListBox Grid.Row="2"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemsSource="{Binding Registros}"
                   SelectedItem="{Binding RegistroSeleccionado, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RecordDetailViewModel">
                <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                  <CheckBox Grid.Column="0"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding Marcado, Mode=TwoWay}" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="subtitulo" Text="{Binding Subtitulo}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Filas con error de parseo: informativo, no bloquea -->
          <Expander Grid.Row="3"
                    Margin="10"
                    IsVisible="{Binding HayErroresParseo}"
                    Background="{DynamicResource PeligroFondo}">
            <Expander.Header>
              <TextBlock Foreground="{DynamicResource Peligro}" FontSize="12">
                <Run Text="{Binding TotalErroresParseo}" />
                <Run Text="fila(s) sin coincidencia con ningún patrón" />
              </TextBlock>
            </Expander.Header>
            <ScrollViewer MaxHeight="180">
              <ItemsControl ItemsSource="{Binding ErroresParseo}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ErrorParseoDto">
                    <StackPanel Spacing="1" Margin="0,0,0,8">
                      <TextBlock Classes="etiqueta">
                        <Run Text="FILA" />
                        <Run Text="{Binding Fila}" />
                      </TextBlock>
                      <TextBlock Classes="subtitulo" TextWrapping="Wrap" Text="{Binding ValorCrudo}" />
                      <TextBlock Classes="subtitulo"
                                 FontStyle="Italic"
                                 TextWrapping="Wrap"
                                 Text="{Binding Motivo}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Expander>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

      <!-- Detalle -->
      <Border Grid.Column="2" Classes="panel" Padding="18">
        <Grid RowDefinitions="*,Auto">

          <Panel Grid.Row="0">
            <TextBlock Classes="subtitulo"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="Selecciona un registro de la lista."
                       IsVisible="{Binding !HayRegistroSeleccionado}" />

            <views:RecordDetailView DataContext="{Binding RegistroSeleccionado}"
                                    IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).HayRegistroSeleccionado}" />
          </Panel>

          <Grid Grid.Row="1" Margin="0,16,0,0" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0"
                       Classes="subtitulo"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding ProgresoTexto}"
                       IsVisible="{Binding Generando}" />

            <Button Grid.Column="1"
                    Margin="0,0,10,0"
                    Padding="18,9"
                    Content="Generar este"
                    Command="{Binding GenerarDocumentoCommand}"
                    IsEnabled="{Binding !Generando}" />

            <Button Grid.Column="2"
                    Padding="18,9"
                    Content="{Binding TextoBotonMasivo}"
                    Background="{DynamicResource Acento}"
                    Foreground="White"
                    Command="{Binding GenerarSeleccionadosCommand}"
                    IsEnabled="{Binding !Generando}" />
          </Grid>

        </Grid>
      </Border>

    </Grid>
  </Grid>

</Window>
