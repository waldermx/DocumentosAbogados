<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DocGenApp.ViewModels"
             x:Class="DocGenApp.Views.RecordDetailView"
             x:DataType="vm:RecordDetailViewModel"
             x:CompileBindings="True">

  <ScrollViewer>
    <StackPanel Spacing="18" Margin="4">

      <StackPanel Spacing="2">
        <TextBlock Classes="etiqueta" Text="NOMBRE" />
        <TextBlock Classes="valor"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Text="{Binding Nombre}"
                   IsVisible="{Binding Nombre, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="subtitulo"
                   FontStyle="Italic"
                   Text="Sin nombre en la hoja para esta fila."
                   IsVisible="{Binding Nombre, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
      </StackPanel>

      <StackPanel Spacing="2">
        <TextBlock Classes="etiqueta" Text="FILA EN LA HOJA" />
        <TextBlock Classes="valor" Text="{Binding Fila}" />
      </StackPanel>

      <Separator Background="{DynamicResource Borde}" Height="1" />

      <TextBlock Classes="etiqueta" Text="DATOS DE LA HOJA" />

      <ItemsControl ItemsSource="{Binding Campos}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CampoViewModel">
            <Border Classes="panel" Padding="12,10" Margin="0,0,0,8">
              <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="etiqueta" Text="{Binding Nombre}" />
                  <TextBlock Classes="subtitulo"
                             FontFamily="Consolas,Menlo,monospace"
                             Text="{Binding Placeholder}"
                             ToolTip.Tip="Escribe este marcador en la plantilla Word" />
                </StackPanel>
                <TextBlock Classes="valor" Text="{Binding Valor}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>

</UserControl>
